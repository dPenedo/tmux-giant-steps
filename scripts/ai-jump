#!/usr/bin/env bash
# ai-jump — pick a tmux pane whose process matches a pattern and jump to it
# (across sessions if needed). Works for any process; the live preview makes
# it especially handy for AI CLI tools (Claude Code / opencode by default).
#
#   Usage:  ai-jump                   # uses @ai-jump-pattern (or the default)
#           ai-jump '<egrep-pattern>' # one-off pattern for this call
#           ai-jump --from <pane-id>  # pane to sort last (defaults to $TMUX_PANE)
#           ai-jump --list [pattern]  # internal, used by fzf
#           ai-jump --preview <pane>  # internal, used by fzf
set -euo pipefail

SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/config.sh
source "$SELF_DIR/lib/config.sh"
# shellcheck source=lib/preview.sh
source "$SELF_DIR/lib/preview.sh"
# shellcheck source=lib/git.sh
source "$SELF_DIR/lib/git.sh"

DEFAULT_PATTERN="$(tmux_option "@ai-jump-pattern" "claude|opencode")"
# Optional per-pane state (e.g. set by Claude Code hooks): the name of a
# window/pane @option holding it, and "state=color,..." where color is an ANSI
# 0-255 index (so it follows the terminal's palette) and list order is sort
# priority. Empty option name = no colors, no reordering.
STATE_OPTION="$(tmux_option "@ai-jump-state-option" "")"
STATE_COLORS="$(tmux_option "@ai-jump-state-colors" "waiting=1,done=2,working=3")"

usage() {
	sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
}

list_panes() {
	local pattern="$1" origin="${2:-}" hits
	# System-wide PIDs matching the pattern. Checking the pane's tty isn't
	# enough: a process in a nested terminal (e.g. Neovim's :terminal) gets
	# its own pty, so it no longer shares a tty with the pane even though
	# it's still a descendant in the process tree. The [c] bracket trick
	# keeps grep from matching its own invocation.
	hits=$(ps -eo pid=,args= | grep -iE "$(bracket_first_char "$pattern")" | awk '{print $1}' || true)
	[ -z "$hits" ] && return 0

	# System-wide pid -> ppid map, used to walk up the process tree.
	local -A ppid_of
	local p pp
	while read -r p pp; do
		ppid_of[$p]=$pp
	done < <(ps -eo pid=,ppid=)

	# state -> "rank color", rank being its position in STATE_COLORS.
	local -A state_style
	local entry rank=0
	IFS=',' read -ra entries <<<"$STATE_COLORS"
	for entry in "${entries[@]}"; do
		state_style[${entry%%=*}]="$rank ${entry#*=}"
		rank=$((rank + 1))
	done

	# The pane the picker was launched from goes last and is flagged with
	# "*", the same marker sessionizer uses for the session you're in (and
	# the one tmux itself uses for the current window in `list-windows`).
	# Every other row is ranked by state (STATE_COLORS order, unknown or no
	# state after them) and stable-sorted on that.
	local rows=() mark display line style color repo root state_fmt=""
	[ -n "$STATE_OPTION" ] && state_fmt="#{$STATE_OPTION}"
	# state goes last: IFS=tab collapses empty fields in the middle.
	while IFS=$'\t' read -r pane panepid session wintarget wp win cmd path state; do
		local hit found=0 walk
		for hit in $hits; do
			walk=$hit
			while [ -n "$walk" ] && [ "$walk" != "0" ] && [ "$walk" != "1" ]; do
				if [ "$walk" = "$panepid" ]; then
					found=1
					break
				fi
				walk=${ppid_of[$walk]:-}
			done
			[ "$found" = 1 ] && break
		done
		if [ "$found" = 1 ]; then
			if [ -n "$origin" ] && [ "$pane" = "$origin" ]; then
				mark='*'
			else
				mark=' '
			fi
			# Which checkout the pane is in, so agents running side by side in
			# worktrees of one repo can be told apart.
			repo=""
			if root=$(find_worktree_root "$path") && worktree_read "$root"; then
				repo="${wt_main##*/} [$wt_branch]"
			fi
			display=$(printf '%-18s  %-28s  %-7s  %-20s  %s' "$session" "$repo" "$wp" "$win" "$cmd")
			style=""
			[ -n "${state:-}" ] && style=${state_style[$state]:-}
			if [ -n "$style" ]; then
				rank=${style%% *}
				color=${style#* }
				display=$(printf '\033[38;5;%sm%s\033[0m' "$color" "$display")
			else
				rank=${#entries[@]}
			fi
			# The marker stays uncolored so a row still starts with it.
			display="$mark $display"
			[ "$mark" = '*' ] && rank=999
			line=$(printf '%s\t%s\t%s\t%s\t%s' "$rank" "$pane" "$session" "$wintarget" "$display")
			rows+=("$line")
		fi
	done < <(tmux list-panes -a -F \
		$'#{pane_id}\t#{pane_pid}\t#{session_name}\t#{session_name}:#{window_index}\t#{window_index}.#{pane_index}\t#{window_name}\t#{pane_current_command}\t#{pane_current_path}\t'"$state_fmt")

	[ ${#rows[@]} -gt 0 ] && printf '%s\n' "${rows[@]}" | sort -t$'\t' -s -n -k1,1 | cut -f2-
	return 0
}

# Wraps each pattern term's first char in brackets (claude -> [c]laude), so
# the `ps | grep` invocation doesn't match itself.
bracket_first_char() {
	awk -F'|' '{
		for (i = 1; i <= NF; i++) {
			printf "%s[%s]%s", (i > 1 ? "|" : ""), substr($i, 1, 1), substr($i, 2)
		}
	}' <<<"$1"
}

# Pane to push to the bottom of the list. $TMUX_PANE is no use here: inside a
# popup it holds whatever the *client's* environment had when it attached, not
# the pane the popup was opened over. `display-message` does resolve to the
# client's active pane (i.e. where the user came from) both in a popup and when
# ai-jump is run by hand from a shell. The `neww` path is the exception — its
# own new pane is the active one by then — so the bootstrap passes --from
# '#{pane_id}', which run-shell expands before the window exists.
ORIGIN_PANE=""
if [ "${1:-}" = "--from" ]; then
	ORIGIN_PANE="${2:-}"
	shift 2
elif [ -n "${TMUX:-}" ]; then
	ORIGIN_PANE=$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)
fi

case "${1:-}" in
-h | --help)
	usage
	exit 0
	;;
--list)
	list_panes "${2:-$DEFAULT_PATTERN}" "$ORIGIN_PANE"
	exit 0
	;;
--preview)
	render_pane "$2" 200
	exit 0
	;;
esac

PATTERN="${1:-$DEFAULT_PATTERN}"
self="$0"

sel=$(bash "$self" --from "$ORIGIN_PANE" --list "$PATTERN" | fzf \
	--ansi \
	--delimiter='\t' \
	--with-nth=4 \
	--preview "bash '$self' --preview {1}" \
	--preview-window='right,70%,nowrap,follow' \
	--header='  SESSION              REPO [BRANCH]                 WINDOW   NAME                  CMD   ·  Enter jumps · Ctrl-R refreshes' \
	--bind "ctrl-r:reload(bash '$self' --from '$ORIGIN_PANE' --list '$PATTERN')") || exit 0

[ -z "$sel" ] && exit 0
pane=$(printf '%s' "$sel" | cut -f1)
session=$(printf '%s' "$sel" | cut -f2)
wintarget=$(printf '%s' "$sel" | cut -f3)

tmux select-window -t "$wintarget"
tmux select-pane -t "$pane"
if [ -n "${TMUX:-}" ]; then
	tmux switch-client -t "$session"
else
	tmux attach -t "$session"
fi
